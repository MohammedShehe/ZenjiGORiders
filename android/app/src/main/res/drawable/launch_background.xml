<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- ZenjiGO brand splash background: deep navy (#0B1A33). -->
    <item android:drawable="@color/zenjigo_splash_background" />
    <!-- Transparent ZenjiGO mark; no white/colored box behind the logo. -->
